        <mxCell id="0oY0yhGFXMviBRu67rsU-50" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Columns:&lt;/h1&gt;&lt;p&gt;&lt;b&gt;Material Number:&lt;/b&gt; MARA-MATNR&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Created on:&lt;/b&gt; MARA-ERSDA&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Material Type:&lt;/b&gt; MARA-MTART&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Material Group:&lt;/b&gt; MARA-MATKL&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Base Measuring unit:&lt;/b&gt; MARA-MEINS&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Description:&lt;/b&gt; MAKT-MAKTX&amp;nbsp;&lt;/p&gt;" vertex="1">
